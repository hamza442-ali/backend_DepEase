PORT=3001
ATLAS_URI=mongodb://127.0.0.1:27017/depease
# Generate a fresh random secret of at least 32 bytes; do not reuse one from Git history.
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Existing teacher accounts listed here receive the admin role at /loginT.
ADMIN_EMAILS=admin@hamza.com
UPLOAD_MAX_BYTES=10485760

# Local persistent documents work without external credentials.
DOCUMENT_STORAGE=local
UPLOAD_DIR=data/uploads
# Set DOCUMENT_STORAGE=cloudinary to use the optional cloud provider instead.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Optional email integration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional private bridge (the same token is required by both processes)
JENKINS_BRIDGE_URL=http://127.0.0.1:5000
JENKINS_BRIDGE_TOKEN=
# The following variables are read by the Python bridge, not the Node API.
JENKINS_URL=http://127.0.0.1:8080
JENKINS_USER=
JENKINS_API_TOKEN=
